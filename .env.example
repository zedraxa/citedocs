# Server Configuration
PORT=3000
COLLAB_PORT=1234
NODE_ENV=development

# Database
DATABASE_URL=postgres://citedocs:citedocs_secret_password@localhost:5432/citedocs

# Zotero Translation Server (port 1969 by default)
TRANSLATION_SERVER_URL=http://localhost:1969

# S3 Object Storage (MinIO or AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=citedocs_minio
S3_SECRET_KEY=citedocs_minio_password
S3_BUCKET=citedocs-attachments
S3_DOCUMENTS_BUCKET=citedocs-documents
S3_ATTACHMENTS_BUCKET=citedocs-attachments
S3_REGION=us-east-1
# Set to false for standard AWS S3 virtual-hosted style (defaults to true for MinIO/local endpoints)
S3_FORCE_PATH_STYLE=true

# ONLYOFFICE Document Server Integration
ONLYOFFICE_JWT_SECRET=change_me_in_production_onlyoffice_jwt_secret
ONLYOFFICE_INTERNAL_URL=http://localhost/oo
ONLYOFFICE_PUBLIC_URL=/oo
ONLYOFFICE_STORAGE_URL=http://localhost:3000

# Optional Zotero.org User Sync
ZOTERO_USER_ID=
ZOTERO_API_KEY=
