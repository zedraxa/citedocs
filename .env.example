# Server Configuration
PORT=3000
COLLAB_PORT=1234
NODE_ENV=development

# Database
DATABASE_URL=postgres://citedocs:citedocs_secret_password@localhost:5432/citedocs

# Zotero Translation Server (port 1969 by default)
TRANSLATION_SERVER_URL=http://localhost:1969

# S3 Object Storage (MinIO or AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=citedocs_minio
S3_SECRET_KEY=citedocs_minio_password
S3_BUCKET=citedocs-attachments
S3_REGION=us-east-1

# Optional Zotero.org User Sync
ZOTERO_USER_ID=
ZOTERO_API_KEY=
