{
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

http://{$PUBLIC_HOST:docs.sifirdanbire.com.tr}, https://{$PUBLIC_HOST:docs.sifirdanbire.com.tr} {
	log
	tls internal {
		on_demand
	}
	route {
		# ONLYOFFICE Docs (main editor); X-Forwarded-Host carries the /oo prefix.
		handle_path /oo/* {
			@no_cache path *.html *.json */translations/* /translations/* *zotero-sync-hook.js *api.js *sdkjs-plugins/zotero* /sdkjs-plugins/zotero/*
			handle @no_cache {
				header >Cache-Control "no-cache, no-store, must-revalidate"
				header >CDN-Cache-Control "no-store"
				header >Cloudflare-CDN-Cache-Control "no-store"
				reverse_proxy onlyoffice:80 {
					header_up X-Forwarded-Host {host}/oo
					header_up X-Forwarded-Proto https
					header_down Cache-Control "no-cache, no-store, must-revalidate"
					header_down CDN-Cache-Control "no-store"
					header_down Cloudflare-CDN-Cache-Control "no-store"
				}
			}
			@versioned path_regexp ^/[0-9]+
			handle @versioned {
				reverse_proxy onlyoffice:80 {
					header_up X-Forwarded-Host {host}/oo
					header_up X-Forwarded-Proto https
				}
			}
			handle {
				reverse_proxy onlyoffice:80 {
					header_up X-Forwarded-Host {host}/oo
					header_up X-Forwarded-Proto https
				}
			}
		}
		reverse_proxy /api/* server:3000
		reverse_proxy /health server:3000
		handle_path /collab* {
			reverse_proxy server:1234
		}
		reverse_proxy web:80
	}
}
